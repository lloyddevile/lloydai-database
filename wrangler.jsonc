{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lloyd-license-portal",
  "main": "server/worker-entry.mjs",
  "routes": [
    {
      "pattern": "lloydai-db.my.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "343430c6ba234ab295fcf53e110994d9"
    }
  ]
}
